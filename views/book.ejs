<% layout("layouts/boilerplate", { title: "Home" }) %>

<section class="container my-5">

    <h2 class="text-center mb-4">
        📚 Welcome to the College Library
    </h2>

    <!-- Search Form -->

    <form action="/books" method="GET" class="row g-3 mb-5">

        <div class="col-md-6">
            <input
                type="text"
                name="search"
                class="form-control"
                placeholder="Search by Title or Author..."
                value="<%= search || '' %>">
        </div>

        <div class="col-md-4">

            <select name="category" class="form-select">

                <option value="All">All Categories</option>

                <% categories.forEach(cat => { %>

                    <option
                        value="<%= cat %>"
                        <%= category===cat ? "selected" : "" %>>

                        <%= cat %>

                    </option>

                <% }) %>

            </select>

        </div>

        <div class="col-md-2">

            <button class="btn btn-primary w-100">
                🔍 Search
            </button>

        </div>

    </form>

    <!-- Books -->

    <div class="row">

        <% if(books.length>0){ %>

            <% books.forEach(book=>{ %>

                <%
                    let avgRating = 0;

                    if(book.ratings && book.ratings.length > 0){
                        avgRating =
                            book.ratings.reduce((sum,r)=>sum+r.value,0)
                            / book.ratings.length;
                    }
                %>

                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card shadow h-100">

                        <img
                            src="<%= book.image %>"
                            class="card-img-top"
                            height="300"
                            style="object-fit:cover;">

                        <div class="card-body">

                            <h5 class="fw-bold">
                                <%= book.title %>
                            </h5>

                            <p class="text-muted mb-2">
                                <%= book.author %>
                            </p>

                            <p>
                                <strong>Category:</strong>
                                <%= book.category %>
                            </p>

                            <span class="badge <%= book.available ? 'bg-success':'bg-danger' %>">

                                <%= book.available ? "Available" : "Unavailable" %>

                            </span>

                            <hr>

                            <p class="mb-0">

                                ⭐ <strong><%= avgRating.toFixed(1) %></strong>

                                (<%= book.ratings ? book.ratings.length : 0 %> Ratings)

                            </p>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <a
                                href="/books/<%= book._id %>"
                                class="btn btn-primary w-100">

                                View Details

                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <div class="col-12">

                <div class="alert alert-warning text-center">

                    📚 No Books Found

                </div>

            </div>

        <% } %>

    </div>

</section>