<% layout("layouts/boilerplate", { title: "Edit Book" }) %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-warning text-dark text-center py-3">

                    <h2 class="mb-0">✏️ Edit Book</h2>

                </div>

                <div class="card-body p-4">

                   <form action="/admin/books/<%= book._id %>" method="POST">

                        

                        <!-- Book Title -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Book Title
                            </label>

                            <input
                                type="text"
                                name="title"
                                class="form-control"
                                value="<%= book.title %>"
                                required>

                        </div>

                        <!-- Author -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Author
                            </label>

                            <input
                                type="text"
                                name="author"
                                class="form-control"
                                value="<%= book.author %>"
                                required>

                        </div>

                        <!-- Category -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Category
                            </label>

                            <input
                                type="text"
                                name="category"
                                class="form-control"
                                value="<%= book.category %>"
                                required>

                        </div>

                        <!-- Availability -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Availability
                            </label>

                            <select
                                name="available"
                                class="form-select">

                                <option
                                    value="true"
                                    <%= book.available ? "selected" : "" %>>

                                    Available

                                </option>

                                <option
                                    value="false"
                                    <%= !book.available ? "selected" : "" %>>

                                    Unavailable

                                </option>

                            </select>

                        </div>

                        <!-- Current Image -->

                        <% if(book.image){ %>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Current Cover
                            </label>

                            <br>

                            <img
                                src="<%= book.image %>"
                                width="150"
                                class="rounded shadow">

                        </div>

                        <% } %>

                        <!-- New Image -->

                        

                        <!-- Current PDF -->

                        <% if(book.ebook){ %>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Current PDF
                            </label>

                            <br>

                            <a
                                href="<%= book.ebook %>"
                                target="_blank"
                                class="btn btn-outline-primary btn-sm">

                                📄 View Current PDF

                            </a>

                        </div>

                        <% } %>

                        <!-- New PDF -->

                       

                        <div class="d-flex gap-3">

                            <button
                                type="submit"
                                class="btn btn-warning flex-fill">

                                💾 Update Book

                            </button>

                            <a
                                href="/admin/books"
                                class="btn btn-secondary flex-fill">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>