<% layout("layouts/boilerplate",{title:"PDF Reader"}) %>

<div class="container-fluid mt-4">

<div class="card shadow-lg">

<div class="card-header d-flex justify-content-between align-items-center">
    <br>
    <br>
    <br>
    <br>
    <br>

<h4>📖 <%= book.title %></h4>

<div>

<span class="fw-bold">
Page
<span id="page_num"></span> /
<span id="page_count"></span>
</span>



<button id="zoomIn" class="btn btn-success btn-sm">
➕
</button>

<button id="zoomOut" class="btn btn-warning btn-sm">
➖
</button>

<a href="<%= book.ebook %>"
download
class="btn btn-info btn-sm">

⬇ Download

</a>

<button
id="fullscreen"
class="btn btn-dark btn-sm">

⛶

</button>

</div>

</div>

<div class="card-body text-center position-relative">

    <button id="prevArrow" class="pdf-arrow left-arrow">
        &#10094;
    </button>

    <canvas id="pdf-render"></canvas>

    <button id="nextArrow" class="pdf-arrow right-arrow">
        &#10095;
    </button>

</div>

</div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
pdfjsLib.GlobalWorkerOptions.workerSrc =
"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
</script>

<script>

const url="<%= book.ebook %>";

let pdfDoc=null;

let pageNum=1;

let scale=1;

const canvas=document.getElementById("pdf-render");

const ctx=canvas.getContext("2d");

function renderPage(num, direction = "right") {

    if (direction === "right") {

        canvas.classList.add("slide-right");

    } else {

        canvas.classList.add("slide-left");

    }

    setTimeout(() => {

        pdfDoc.getPage(num).then(page => {

            const viewport = page.getViewport({ scale });

            canvas.height = viewport.height;
            canvas.width = viewport.width;

            page.render({
                canvasContext: ctx,
                viewport
            });

            document.getElementById("page_num").textContent = num;

            canvas.classList.remove("slide-left");
            canvas.classList.remove("slide-right");

        });

    }, 200);

}

document.getElementById("page_num").textContent = pageNum;



pdfjsLib.getDocument(url).promise.then(pdf=>{

pdfDoc=pdf;

document.getElementById("page_count").textContent=pdf.numPages;

renderPage(pageNum);

});

document.getElementById("prevArrow").onclick=()=>{

if(pageNum<=1)return;

pageNum--;

renderPage(pageNum,"left");

};

document.getElementById("nextArrow").onclick=()=>{

if(pageNum>=pdfDoc.numPages)return;

pageNum++;

renderPage(pageNum,"right");

};
document.getElementById("zoomIn").onclick=()=>{

scale+=0.2;

renderPage(pageNum);

};

document.getElementById("zoomOut").onclick=()=>{

if(scale<=0.6)return;

scale-=0.2;

renderPage(pageNum);

};

document.getElementById("fullscreen").onclick=()=>{

canvas.requestFullscreen();

};
pdfjsLib.getDocument(url).promise
.then(pdf => {

    pdfDoc = pdf;

    document.getElementById("page_count").textContent = pdf.numPages;

    renderPage(pageNum);

})
.catch(err => {

    console.error(err);

    alert(err.message);

});
</script>