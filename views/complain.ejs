<% layout("layouts/boilerplate", { title: "Complaint" }) %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-danger text-white text-center">

                    <h2 class="mb-0">⚠ Submit Complaint</h2>

                </div>

                <div class="card-body p-4">

                    <form action="/complain" method="POST">

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Full Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                placeholder="Enter your name"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Email Address
                            </label>

                            <input
                                type="email"
                                name="email"
                                class="form-control"
                                placeholder="Enter your email"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Complaint Subject
                            </label>

                            <input
                                type="text"
                                name="subject"
                                class="form-control"
                                placeholder="Enter complaint subject"
                                required>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Complaint Details
                            </label>

                            <textarea
                                name="message"
                                rows="5"
                                class="form-control"
                                placeholder="Describe your complaint..."
                                required></textarea>

                        </div>

                        <button
                            class="btn btn-danger w-100">

                            🚀 Submit Complaint

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>