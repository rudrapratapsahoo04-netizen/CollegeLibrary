<section class="bg-light py-5">

<div class="container">

<h2 class="text-center fw-bold mb-5">

Why Choose Our Library

</h2>

<div class="row g-4">

<div class="col-md-3">

<div class="feature-card">

<h1>📚</h1>

<h4>5000+ Books</h4>

<p>Large Collection</p>

</div>

</div>

<div class="col-md-3">

<div class="feature-card">

<h1>⚡</h1>

<h4>Fast Search</h4>

