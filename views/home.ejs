</div>

</div>

<div class="col-md-3">

<div class="feature-card">

<h1>🔒</h1>

<h4>Secure</h4>

<p>Admin Controlled</p>

</div>

</div>

<div class="col-md-3">

<div class="feature-card">

<h1>🎓</h1>

<h4>Students</h4>

<p>Easy Access</p>

</div>

</div>

</div>

</div>

</section>

