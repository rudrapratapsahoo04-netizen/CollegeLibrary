<% layout("layouts/boilerplate", { title: "College Library" }) %>

<!-- Hero Section -->
<section class="hero d-flex align-items-center justify-content-center text-center text-white">

    <div class="hero-content">

        <h1 class="hero-title">
    Welcome to <br>
    <span>College Library</span>
</h1>

        <p class="hero-subtitle">
            Your Digital Gateway to Knowledge & Learning
        </p>

        <div class="d-flex flex-column flex-md-row justify-content-center gap-3 mt-4">

<a href="/books" class="btn btn-primary hero-btn">

📚 Explore Books

</a>

</div>

    </div>

</section>

<!-- About -->
<section class="container py-5">

    <div class="row align-items-center">

        <div class="col-lg-6">

            <img src="https://images.unsplash.com/photo-1521587760476-6c12a4b040da?w=900"
                class="img-fluid rounded-4 shadow">

        </div>

        <div class="col-lg-6">
            
            <h2 class="fw-bold mb-4">
                About Our Library
            </h2>
            
            <p class="text-muted fs-5">

                Our College Library provides thousands of books,
                journals and research materials for students.

                Easily search books, check availability and
                manage the library through a modern system.

            </p>

        </div>

    </div>

</section>

