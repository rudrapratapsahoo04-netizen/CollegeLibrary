<% layout("layouts/boilerplate", { title: "Contact Us" }) %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center">

                    <h2 class="mb-0">📩 Contact Us</h2>

                </div>

                <div class="card-body p-4">

                    <form action="/contact" method="POST">

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Full Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                placeholder="Enter your full name"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Email Address
                            </label>

                            <input
                                type="email"
                                name="email"
                                class="form-control"
                                placeholder="Enter your email"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Subject
                            </label>

                            <input
                                type="text"
                                name="subject"
                                class="form-control"
                                placeholder="Enter subject"
                                required>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Message
                            </label>

                            <textarea
                                name="message"
                                rows="5"
                                class="form-control"
                                placeholder="Write your message..."
                                required></textarea>

                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary w-100">

                            📨 Send Message

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
